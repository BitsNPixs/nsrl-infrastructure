---
import { Image } from "astro:assets";
import { founder } from "../data/site";
import founderPortrait from "../assets/founder.png";
---

<section class="founder">
  <div class="founder__card shell">
    <div class="founder__grid">
      <h2 class="section-title founder__title" data-reveal>{founder.title}</h2>

      <Image
        class="founder__photo"
        data-reveal
        data-reveal-delay="200"
        src={founderPortrait}
        alt={`${founder.name}, ${founder.role} of NSRL Infrastructure`}
        widths={[440, 732, 880, 1464]}
        sizes="(min-width: 1101px) 39vw, (min-width: 560px) 440px, 100vw"
        loading="lazy"
      />

      <div class="founder__signature_mobile">
          <p class="founder__name">{founder.name}</p>
          <p class="founder__role">{founder.role}</p>
      </div>

      <div class="founder__text" data-reveal data-reveal-delay="120">
        <div class="prose founder__prose">
          {founder.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="founder__signature_desktop">
          <p class="founder__name">{founder.name}</p>
          <p class="founder__role">{founder.role}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Card x60..1860; the portrait is inset only ~21-32px from its edges,
     while the copy keeps the 245px content margin. */
  .founder__card {
    padding: calc(21 * var(--k)) calc(32 * var(--k)) calc(24 * var(--k))
      calc(185 * var(--k));
    border-radius: var(--r-card);
    background: var(--c-surface);
  }

  /* The portrait sits after the heading in the source so the stacked layout
     reads title -> portrait -> copy without a CSS-only reorder. On the wide
     layout explicit placement puts it back in the right-hand column, spanning
     both rows of the left column. */
  .founder__grid {
    display: grid;
    grid-template-columns: 705fr 146fr 732fr;
    align-items: start;
  }

  .founder__title {
    grid-column: 1;
    grid-row: 1;
    padding-top: calc(73 * var(--k));
  }

  .founder__photo {
    grid-column: 3;
    grid-row: 1 / 3;
    width: 100%;
    height: auto;
    border-radius: var(--r-media);
  }

  .founder__text {
    grid-column: 1;
    grid-row: 2;
    padding-bottom: calc(68 * var(--k));
  }

  .founder__prose {
    margin-top: calc(36 * var(--k));
  }

  .founder__name {
    margin-top: calc(103 * var(--k));
    font-size: var(--fs-24);
    line-height: 1.3;
    color: var(--c-name);
  }

  .founder__role {
    margin-top: calc(5 * var(--k));
    font-size: var(--fs-body);
    line-height: 1.4;
    font-style: italic;
    color: var(--c-role);
  }

  @media (max-width: 1100px) {
    .founder__card {
      padding: calc(28 * var(--k));
    }

    /* One column, source order: title, portrait, copy. */
    .founder__grid {
      grid-template-columns: 1fr;
      gap: calc(36 * var(--k));
    }

    .founder__title,
    .founder__photo,
    .founder__text {
      grid-column: 1;
      grid-row: auto;
    }

    .founder__title {
      padding-top: calc(24 * var(--k));
    }

    .founder__text {
      padding-bottom: 0;
    }

    /* Uncapped, the portrait fills a tablet viewport almost top to bottom.
       Below ~560px the column is already narrower than the cap. */
    .founder__photo {
      max-width: 440px;
    }

    /* The grid gap already separates the portrait from the copy. */
    .founder__prose {
      margin-top: 0;
    }

    .founder__name {
      margin-top: calc(40 * var(--k));
    }
  }

  @media (max-width: 640px) {
    .founder__card {
      padding: 20px;
    }
  }
</style>

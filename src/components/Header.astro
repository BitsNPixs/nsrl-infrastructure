---
import { site } from "../data/site";
---

<header class="header">
  <div class="header__bar wide">
    <a class="header__logo" href="#home">{site.wordmark}</a>

    <nav class="header__nav" aria-label="Primary">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header__cta" href={site.cta.href}>{site.cta.label}</a>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label="Open menu"
    >
      <span class="header__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="drawer-backdrop" data-drawer-close></div>

<div
  class="drawer"
  id="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  inert
>
  <nav class="drawer__nav" aria-label="Mobile">
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} data-drawer-close>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="drawer__cta" href={site.cta.href} data-drawer-close>
    {site.cta.label}
  </a>
</div>

<style>
  /* Nav bar: full-bleed #F0F0F0, 100px tall on the 1920 canvas.
     Content sits in the 1720 container (x 100 .. 1820).
     It stays above the drawer so the toggle keeps working as a close button. */
  .header {
    position: sticky;
    top: 0;
    z-index: 120;
    background: var(--c-surface);
  }

  /* Three tracks so the links sit on the page centre-line (x960), the way
     the design places them — not merely centred in the leftover space. */
  .header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: calc(100 * var(--k));
  }

  .header__logo {
    font-size: var(--fs-24);
    font-weight: 700;
    letter-spacing: -0.041em;
    color: var(--c-ink);
    white-space: nowrap;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
    gap: calc(43 * var(--k));
  }

  .header__nav a {
    font-size: var(--fs-body);
    color: var(--c-heading);
    transition: opacity 0.2s ease;
  }

  .header__nav a:hover {
    opacity: 0.6;
  }

  .header__cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: calc(50 * var(--k));
    padding-inline: calc(31 * var(--k));
    border-radius: 999px;
    background: var(--c-dark);
    color: #fff;
    font-size: var(--fs-20);
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .header__cta:hover {
    background: #3d3d3d;
  }

  .header__cta:active {
    transform: translateY(1px);
  }

  /* Hamburger --------------------------------------------------------- */
  .header__toggle {
    display: none;
    grid-column: 3;
    justify-self: end;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-ink);
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.2s ease;
  }

  .header__bars {
    position: relative;
    margin-inline: auto;
  }

  .header__bars::before,
  .header__bars::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .header__bars::before {
    top: -7px;
  }

  .header__bars::after {
    top: 7px;
  }

  /* Collapses into an X while the drawer is open. */
  .header__toggle[aria-expanded="true"] .header__bars {
    background: transparent;
  }

  .header__toggle[aria-expanded="true"] .header__bars::before {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle[aria-expanded="true"] .header__bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Drawer ------------------------------------------------------------ */
  .drawer {
    position: fixed;
    inset-block: 0;
    left: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    width: min(320px, 82vw);
    /* Clears the sticky bar the drawer slides in underneath. */
    padding: 96px 28px 32px;
    background: var(--c-surface);
    box-shadow: 0 0 48px rgba(0, 0, 0, 0.16);
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    transform: translateX(-100%);
    transition:
      transform 0.4s var(--ease-out),
      visibility 0s linear 0.4s;
  }

  .drawer.is-open {
    visibility: visible;
    transform: none;
    transition:
      transform 0.4s var(--ease-out),
      visibility 0s;
  }

  .drawer__nav {
    width: 100%;
  }

  .drawer__nav ul {
    display: flex;
    flex-direction: column;
  }

  .drawer__nav li + li {
    border-top: 1px solid rgba(0, 0, 0, 0.09);
  }

  .drawer__nav a {
    display: block;
    padding: 16px 0;
    font-size: var(--fs-24);
    color: var(--c-heading);
    transition: opacity 0.2s ease;
  }

  .drawer__nav a:hover {
    opacity: 0.6;
  }

  .drawer__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    padding-inline: 28px;
    border-radius: 999px;
    background: var(--c-dark);
    color: #fff;
    font-size: var(--fs-20);
  }

  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(20, 20, 20, 0.45);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out),
      visibility 0s linear 0.4s;
  }

  .drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.4s var(--ease-out),
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer-backdrop,
    .header__bars,
    .header__bars::before,
    .header__bars::after {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 860px) {
    .header__bar {
      grid-template-columns: 1fr auto;
      height: 68px;
    }

    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle {
      display: block;
    }
  }

  /* The drawer is a small-screen affordance only. */
  @media (min-width: 861px) {
    .drawer,
    .drawer-backdrop {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".header__toggle");
  const drawer = document.querySelector<HTMLElement>("#nav-drawer");
  const backdrop = document.querySelector<HTMLElement>(".drawer-backdrop");

  if (toggle && drawer && backdrop) {
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const open = () => {
      // Compensate for the scrollbar the lock removes, so nothing shifts.
      const gap = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.setProperty("--sbw", gap + "px");
      document.body.classList.add("nav-open");

      drawer.removeAttribute("inert");
      drawer.classList.add("is-open");
      backdrop.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close menu");

      drawer.querySelector<HTMLElement>("a")?.focus();
    };

    const close = ({ restoreFocus = true } = {}) => {
      document.body.classList.remove("nav-open");
      drawer.classList.remove("is-open");
      backdrop.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");

      // Move focus out before making the drawer inert.
      if (restoreFocus) toggle.focus();
      drawer.setAttribute("inert", "");
    };

    toggle.addEventListener("click", () => (isOpen() ? close() : open()));

    // Backdrop and any link inside the drawer dismiss it. Links keep their
    // default behaviour, so the anchor still scrolls once the lock is off.
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (!isOpen() || !target.closest("[data-drawer-close]")) return;
      close({ restoreFocus: target.tagName !== "A" });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) close();
    });

    // Keep tabbing inside the drawer while it is open.
    drawer.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const focusable = drawer.querySelectorAll<HTMLElement>(
        "a[href], button:not([disabled])"
      );
      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Leaving the small-screen range strands the drawer open otherwise.
    window
      .matchMedia("(min-width: 861px)")
      .addEventListener("change", (event) => {
        if (event.matches && isOpen()) close({ restoreFocus: false });
      });
  }
</script>
